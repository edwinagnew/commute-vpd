#!/usr/bin/env bash
# Start an agent on a task, in one command. Run it from this clone in an ssh shell on the dev node; the agent keeps
# running after the shell closes.
#   fleet/start "what to work on"            the lead, e.g. fleet/start "run the decision tree in reports/plans/<plan>.md"
#   fleet/start -r lead-2 "what to work on"  a second agent with the lead's brief (fleet/roles/lead.md), its own clone,
#                                            task file, memory and budget; for a line of work the lead is not on
#   fleet/start                              no task: the agent does only analysis of what already exists (/design, class 1)
# The task goes in the role's task file (fleet/fleet.sh, fleet_task_file: FLEET_DATA/tonight for the lead,
# FLEET_DATA/agents/<role>/task otherwise), which the agent rereads every iteration, so editing it redirects the agent.
# Then: fleet/check to see how each agent is doing, fleet/stop ROLE (or all) to end them.
set -euo pipefail
[[ "${1:-}" == -h || "${1:-}" == --help ]] && { sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"; exit 0; }
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$here/fleet.sh"
role=lead
if [[ "${1:-}" == -r ]]; then role=${2:?fleet/start -r ROLE "task"}; shift 2; fi
task=$(fleet_task_file "$role")
mkdir -p "$(dirname "$task")"
if [[ $# -gt 0 ]]; then
  printf '%s\n' "$*" > "$task"; echo "task for $role ($task): $*"
else
  : > "$task"; echo "task for $role: none (analysis of existing results only)"
fi
# A finished agent sits idle with no wake-up and would never read the new task: replace its window.
[[ -e "$FLEET_DATA/agents/$role/done" ]] && tmux kill-window -t "$FLEET_SESSION:$role" 2>/dev/null
"$here/up" "$role"
"$here/summarize" "$role" &> /dev/null &   # the task's title for fleet/check, without waiting for cron
echo "Started. Check on it with: fleet/check    Watch it live: tmux attach -t $FLEET_SESSION (leave with Ctrl-b d)"
