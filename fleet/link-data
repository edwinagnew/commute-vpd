#!/usr/bin/env bash
# Point a clone's gitignored big folders at the one shared copy in FLEET_DATA (plan section 3, "Repo layout"):
# artifacts/, .venv, cluster/logs and each experiment's results/large/. fleet/up runs it for every role.
#   fleet/link-data [CLONE]   default: the clone this script is in
# A real folder already in the clone's place is left alone, with a warning, so nothing is ever deleted.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/fleet.sh"
d=$(readlink -f "${1:-$(dirname "$(readlink -f "$0")")/..}")
link() {  # link TARGET PATH
  if [[ -L "$2" ]]; then ln -sfn "$1" "$2"
  elif [[ -e "$2" ]]; then echo "link-data: $2 is a real folder; move its contents to $1 and rerun" >&2
  else mkdir -p "$(dirname "$2")"; ln -s "$1" "$2"; fi
}
link "$FLEET_DATA/artifacts" "$d/artifacts"
link "$FLEET_DATA/venv" "$d/.venv"
link "$FLEET_DATA/cluster-logs" "$d/cluster/logs"
for e in "$d"/experiments/*/; do
  e=$(basename "$e")
  mkdir -p "$FLEET_DATA/results-large/$e"
  link "$FLEET_DATA/results-large/$e" "$d/experiments/$e/results/large"
done
