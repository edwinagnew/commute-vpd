#!/usr/bin/env python3
"""Replace one section of an agent's handoff note without reading the note first.

  fleet/handoff ROLE set HEADING < text   replace the section whose "## " heading starts with HEADING (ignoring
                                          case) by the text on standard input, which starts with its own "## "
                                          heading; a note with no such section gets it appended
  fleet/handoff ROLE headings             list the note's "## " headings, with each section's line count

The note is FLEET_DATA/agents/ROLE/handoff.md (fleet/fleet.conf); from mats-fleet's ci/handoff. A section runs
from its heading to the next "## " heading or the end. Pass the text through a quoted heredoc (<<'EOF'), so the
shell runs nothing in it.
"""
import argparse
import re
import sys
from pathlib import Path



def fleet_data():
    """FLEET_DATA from fleet/fleet.conf, whose values use no variable but $HOME."""
    for line in (Path(__file__).resolve().parent / "fleet.conf").read_text().splitlines():
        if line.startswith("FLEET_DATA="):
            return Path(line.split("=", 1)[1].split("#")[0].strip().replace("$HOME", str(Path.home())))
    raise SystemExit("handoff: no FLEET_DATA in fleet/fleet.conf")


def sections(lines):
    """(start, end) line ranges of each "## " section."""
    starts = [i for i, line in enumerate(lines) if line.startswith("## ")]
    return [(s, (starts[k + 1] if k + 1 < len(starts) else len(lines))) for k, s in enumerate(starts)]


def replace(text, heading, new):
    lines = text.splitlines()
    new_lines = new.rstrip("\n").splitlines()
    if not new_lines or not new_lines[0].startswith("## "):
        raise ValueError('the new text must start with its "## " heading')
    want = heading.lower().lstrip("# ").strip()
    found = [(s, e) for s, e in sections(lines) if lines[s][3:].strip().lower().startswith(want)]
    if len(found) > 1:
        raise ValueError(f"{len(found)} sections start with {heading!r}; give more of the heading")
    if found:
        s, e = found[0]
        # Keep the blank line that separated this section from the next one.
        tail = [""] if e < len(lines) else []
        lines[s:e] = new_lines + tail
    else:
        lines += ([""] if lines and lines[-1].strip() else []) + new_lines
    return "\n".join(lines) + "\n"


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("role")
    ap.add_argument("action", choices=["set", "headings"])
    ap.add_argument("heading", nargs="?")
    a = ap.parse_args(argv)
    path = fleet_data() / "agents" / a.role / "handoff.md"
    text = path.read_text() if path.exists() else f"# {a.role} handoff\n"
    if a.action == "headings":
        lines = text.splitlines()
        for s, e in sections(lines):
            print(f"{lines[s]}  ({e - s} lines)")
        return 0
    if not a.heading:
        ap.error("set needs a HEADING")
    try:
        out = replace(text, a.heading, sys.stdin.read())
    except ValueError as e:
        print(f"handoff: {e}; nothing written", file=sys.stderr)
        return 1
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(out)
    tmp.replace(path)
    print(f"handoff: wrote {path} ({len(out.splitlines())} lines)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
