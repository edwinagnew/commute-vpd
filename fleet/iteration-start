#!/usr/bin/env bash
# Everything an agent needs at the start of an iteration, in one call (after mats-fleet's ci/iteration-start).
#   fleet/iteration-start ROLE
# Prints, in order: a restart request; the pull's result and any unpushed commits; the role's handoff note (what it
# was doing, what's next); its live Slurm jobs; where to see its pods; the research-log queue's length; and, for the
# lead, report files outside reports/<type>/, experiments without a notebook and the agents waiting at a prompt.
# Exits 1 when the pull did not finish.
set -uo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/fleet.sh"
role=${1:?usage: fleet/iteration-start ROLE}
repo="$(git rev-parse --show-toplevel)"
adir="$FLEET_DATA/agents/$role"
mkdir -p "$adir"
code=0

[[ -e "$adir/restart-requested" ]] && echo "RESTART REQUESTED ($adir/restart-requested): follow fleet/roles/${role%-[0-9]*}.md, Restarts, before anything else."

# Merge, never rebase (plan section 3). A failed merge is left for the agent to resolve.
if out=$(git -C "$repo" pull --no-rebase --autostash 2>&1); then
  echo "pull: $(tail -1 <<< "$out")"
else
  echo "pull FAILED; resolve it first (for MEMORY.md keep both sides' lines):"; echo "$out" | tail -5; code=1
fi
ahead=$(git -C "$repo" rev-list --count origin/main..HEAD 2>/dev/null || echo 0)
[[ "$ahead" != 0 ]] && echo "unpushed: $ahead commit(s); git pull --no-rebase && git push"
dirty=$(git -C "$repo" status --porcelain | wc -l)
[[ "$dirty" != 0 ]] && echo "uncommitted: $dirty file(s) changed"

task=$(fleet_task_file "$role")
echo "--- task ($task; written by the user with fleet/start, may change between iterations)"
if [[ -s "$task" ]]; then cat "$task"; else echo "none: analysis of what exists only (class 1)"; fi

echo "--- handoff ($adir/handoff.md)"
if [[ -s "$adir/handoff.md" ]]; then cat "$adir/handoff.md"; else echo "none yet: this is the role's first iteration"; fi

echo "--- Slurm jobs (all of $USER's; agents and laptop share the account)"
squeue -u "$USER" -h -o '%i %j %T %M/%l %R' 2>/dev/null || echo "squeue failed"
echo "--- pods: call the remote-kernels status() tool. A live pod-runner subagent or unwatched pod forbids restart-ready."
pending=$(grep -c '^- ' "$repo/docs/research_log/PENDING.md" 2>/dev/null || true)
echo "--- research log: ${pending:-0} queued line(s) in docs/research_log/PENDING.md"
if [[ ${role%-[0-9]*} == lead && ${pending:-0} != 0 ]]; then
  echo "    Flush them (a clerk in the background) before the next experiment's analysis: fleet/roles/lead.md, step 3."
fi
if [[ ${role%-[0-9]*} == lead ]]; then
  # Reports live in reports/<type>/; experiments from E35 on have a notebook (user, 2026-10-26).
  stray=$(find "$repo/reports" -maxdepth 1 -type f -name '*.md' -printf '%f ')
  [[ -n "$stray" ]] && echo "    reports/ top level: $stray-> git mv each into reports/<type>/ (CLAUDE.md, Layout)."
  missing=""
  for e in $(grep -o '^| E[0-9]*' "$repo/experiments/TRIED.md" | grep -o '[0-9]*' | sort -un); do
    (( 10#$e >= 35 )) && ! compgen -G "$repo/notebooks/E${e}_*.ipynb" > /dev/null && missing+=" E$e"
  done
  [[ -n "$missing" ]] && echo "    no notebook for:$missing -> /writeup, notebook with the report (fleet/roles/lead.md, step 3)."
fi
if [[ ${role%-[0-9]*} == lead && -s "$FLEET_DATA/blocked.txt" ]]; then
  echo "--- agents waiting at a prompt ($FLEET_DATA/blocked.txt):"; cat "$FLEET_DATA/blocked.txt"
fi
exit $code
